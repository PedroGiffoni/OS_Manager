DATABASE_URL=sqlite:///./data/os_manager.db
COOKIE_SECURE=false
APP_TIMEZONE=America/Sao_Paulo
TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Integrações opcionais. Configure o mesmo segredo no provedor e no backend.
# Sem segredo, os webhooks retornam 403 e a aplicação continua operando normalmente.
# GITHUB_WEBHOOK_SECRET=
# GITLAB_WEBHOOK_TOKEN=
# BITBUCKET_WEBHOOK_SECRET=

# Publicação de testes: consulte docs/DEPLOYMENT.md
# CLOUD_DEPLOYMENT=true
# PORT=8000
# OS_MANAGER_ALLOW_DEMO_SEED=false
# OS_MANAGER_DEMO_PASSWORD=defina-no-painel-da-hospedagem

# E-mail opcional para notificações genéricas; sem SMTP, a aplicação segue apenas com avisos internos.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Gestão de Demandas <nao-responda@example.org>
# SMTP_STARTTLS=true
# SMTP_SSL=false
# APP_PUBLIC_URL=http://127.0.0.1:5173

# Push de navegador opcional (HTTPS obrigatório no navegador, exceto localhost).
# Gere um par VAPID e uma chave Fernet separada; nunca reutilize esta chave de sessão.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:admin@example.org
# PUSH_SUBSCRIPTION_FERNET_KEY=
