{
  "name": "os-manager-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.js",
    "format:check": "prettier --check src e2e *.ts *.js"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "5.74.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.55.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.2",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
